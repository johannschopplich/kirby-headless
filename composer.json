{
  "name": "johannschopplich/kirby-headless",
  "description": "JSON pages and KQL queries, served behind one bearer token",
  "type": "kirby-plugin",
  "version": "8.2.0",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "headless",
    "headless-cms",
    "kql"
  ],
  "license": "MIT",
  "homepage": "https://kirby.tools/headless",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^5",
    "getkirby/kql": "^3",
    "phpunit/phpunit": "^12"
  },
  "scripts": {
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev --optimize-autoloader"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby-plugin-path": "vendor/kirby-plugins",
    "kirby": {
      "compatible": "^5.0"
    }
  }
}
